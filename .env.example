# The public origin of the deployment.
#
# Used for canonical URLs, Open Graph tags, sitemap.xml and robots.txt, so it
# must be the real production domain for search engines to index correctly.
# On Vercel this can be left unset — VERCEL_PROJECT_PRODUCTION_URL is used as a
# fallback — but setting it explicitly is better, because that fallback differs
# between production and preview deployments.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
