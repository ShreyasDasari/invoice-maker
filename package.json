{
  "name": "invoice-maker",
  "version": "1.0.0",
  "private": true,
  "description": "Free invoice maker. Create a professional invoice in seconds. No signup, no watermark.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
